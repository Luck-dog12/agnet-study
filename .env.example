# 复制为 .env，并仅在本地填写真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 仅决定尚未建立持久身份的新会话；显式 CLI 参数优先，恢复会话始终采用 execution.json。
# 可设为 local 或 aliyun-sandbox；回滚时改回 local。
AGENT_DEFAULT_EXECUTION_BACKEND=local
# 10..600 秒；OpenAI SDK 请求超时。
DEEPSEEK_TIMEOUT_SECONDS=180
# 0..5；由 SDK 对可重试请求执行。
DEEPSEEK_MAX_RETRIES=2
# Brave Web Search 正式 API 密钥；仅 web_search 在宿主内部读取。
BRAVE_SEARCH_API_KEY=

# 阿里云 Agent Sandbox 极速版 + OSS 动态挂载配置。
# 默认关闭；同时作为探针和 `agent --execution-backend aliyun-sandbox`
# 的远端执行总开关。CLI 构造期只校验配置，首次远端工具调用才创建云资源。
ALIYUN_SANDBOX_PROBE_ENABLED=false
# 阶段 2 恢复探针独立开关；还要求上面的基础探针开关为 true。
ALIYUN_SANDBOX_RECOVERY_PROBE_ENABLED=false
# Sandbox 网络出口默认严格关闭；只有业务明确需要访问公网时才显式设为 true。
ALIYUN_SANDBOX_ALLOW_INTERNET_ACCESS=false
E2B_API_KEY=
E2B_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com
# 留空时使用 E2B SDK 默认模板；也可填写阿里云侧已验证的模板名。
E2B_TEMPLATE=
# 30..3600 秒：每次云端租约的存活时间；活动工具自动有限续期，进程崩溃后由云端到期回收。
ALIYUN_SANDBOX_TIMEOUT_SECONDS=300
# 30..3600 秒；无活动工具/审批保留时，空闲到期销毁两实例，下次新工具按需重建。
ALIYUN_SANDBOX_IDLE_TIMEOUT_SECONDS=120
# 60..86400 秒；同一会话两实例作为一组累计驻留上限，重启/--resume 不清零，回收间隔不计。
# 这是时长限制，不是金额预算；两个实例的实际费用与 OSS 存储另计。
ALIYUN_SANDBOX_MAX_SESSION_SECONDS=3600
# Sandbox 内可信控制面虚拟环境；必须位于 /workspace 和 /mnt 之外，也不会进入 OSS checkpoint。
# 仅当路径缺失时才由 root 初始化并固化；若路径已存在但身份/权限不合格会 fail closed，绝不 --clear 重建。
ALIYUN_SANDBOX_RUNTIME_VENV_DIR=/opt/agnet-study/runtime/venv
# 所有 Agent 触发的远端项目命令都显式使用该非特权用户；root 仅用于可信 runtime 控制面初始化/复查。
ALIYUN_SANDBOX_RUNTIME_USER=user
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 必须是 RAM Policy 仅授权给本任务的非根前缀。
ALIYUN_OSS_BUCKET_PATH=/projects/replace-me/runs/connectivity-probe
ALIYUN_OSS_MOUNT_DIR=/mnt/oss
ALIYUN_OSS_ROLE_ARN=
# 阶段 1 需要写入、回读并删除 marker，因此必须为 false。
ALIYUN_OSS_READ_ONLY=false
# 真实 E2E 还需单独显式设置为 1；普通回归始终跳过云调用。
RUN_ALIYUN_SANDBOX_E2E=0
# 阶段 2 真实 E2E 的额外门控，普通回归默认跳过。
RUN_ALIYUN_SANDBOX_RECOVERY_E2E=0
# Registry + Agent remote runtime 真实 E2E 的独立门控；默认不创建云资源。
RUN_ALIYUN_SANDBOX_LIVE_AGENT_E2E=0
